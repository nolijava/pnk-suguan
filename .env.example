# ─────────────────────────────────────────────────────────────────────────────
# PNK Suguan System — environment template
# Copy to .env.local (gitignored) and fill in real values.
# NEVER commit .env.local or any real password/secret to the repository.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (app runtime + migrations)
DATABASE_URL=postgresql://pnk:CHANGE_ME@localhost:5432/pnk

# Session cookie / crypto env ("development" | "production")
NODE_ENV=development

# ── Initial Administrator bootstrap (ONE-TIME setup; see docs/setup.md) ──────
# The bootstrap creates the single initial Administrator (via the role system).
# Provide the password ONLY through this secret (or a Docker secret file).
# It is NEVER stored in code, migrations, seeds, or this template.
INITIAL_ADMIN_EMAIL=nolijava26@gmail.com
# INITIAL_ADMIN_PASSWORD=<set in .env.local only — never committed>
# Alternative to the env var: point to a Docker/OS secret file:
# INITIAL_ADMIN_PASSWORD_FILE=C:/run/secrets/initial_admin_password

# ── SUPER_ADMIN PUBLISHED-unlock secret (§24 emergency correction) ───────────
# Server-verified secret for POST /api/weeks/:id/correction { mode: "PUBLISHED" }.
# When absent the unlock always fails closed. Set ONLY in .env.local (or a
# Docker/OS secret file); never committed, never logged, never returned by APIs.
# PNK_SUPER_ADMIN_SECRET=<set in .env.local only — never committed>
